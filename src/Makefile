# compiler and flags
CC      := gcc
CFLAGS  := -Wall -Wextra -Iinclude -MMD -MP
LDFLAGS := -lm

DEBUG ?= 1

ifeq ($(DEBUG),1)
	CFLAGS += -g
else
	CFLAGS += -O2
endif

# directories
SRC_DIR   := src
INC_DIR   := include
OBJ_DIR   := obj
BUILD_DIR := build
TEST_DIR  := tests

# source files
SRC_FILES  := $(wildcard $(SRC_DIR)/*.c)
TEST_FILES := $(wildcard $(TEST_DIR)/*.c)

# object files (mirror structure)
OBJ_FILES := $(patsubst $(SRC_DIR)/%.c,$(OBJ_DIR)/%.o,$(SRC_FILES))

# test executables (one per test file)
TEST_BINS := $(patsubst $(TEST_DIR)/%.c,$(BUILD_DIR)/%,$(TEST_FILES))

# dependency files
DEPS := $(OBJ_FILES:.o=.d)

# default target
.PHONY: all
all: dirs $(TEST_BINS)

# ensure directories exist
.PHONY: dirs
dirs:
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(BUILD_DIR)

# compile source files into object files
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) -c $< -o $@

# build test executables
# each test is linked with ALL project object files
$(BUILD_DIR)/%: $(TEST_DIR)/%.c $(OBJ_FILES)
	$(CC) $(CFLAGS) $< $(OBJ_FILES) -o $@ $(LDFLAGS)

# clean
.PHONY: clean
clean:
	rm -rf $(OBJ_DIR) $(BUILD_DIR)

# include dependency files (auto-generated by -MMD -MP)
-include $(DEPS)

# run all tests
.PHONY: test
test: all
	@for t in $(TEST_BINS); do echo "Running $$t"; $$t; done

# run a specific test: make run_<testname>
# example: make run_math
.PHONY: run_%
run_%: $(BUILD_DIR)/%
	@echo "Running $<"
	@./$<

